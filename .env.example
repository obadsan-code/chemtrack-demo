# --- Bot de Telegram (bot.py) ---
# Token de @BotFather
BOT_TOKEN=

# Cadena de conexión a PostgreSQL (la usan el bot y el dashboard)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/chemtrack

# IDs de Telegram por rol, separados por comas (ej. 111111111,222222222)
ADMIN_IDS=
SUPERVISOR_IDS=
OPERATOR_A_IDS=
OPERATOR_B_IDS=
OPERATOR_C_IDS=

# Chat donde se envían los respaldos automáticos (SQL + CSV)
BACKUP_CHAT_ID=

# --- Dashboard (dashboard/server.js) ---
PORT=3001

# --- Front de React (dashboard/src) ---
REACT_APP_API_URL=http://localhost:3001
